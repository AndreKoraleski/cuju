# Copyright 2026 The cuju Authors
# SPDX-License-Identifier: Apache-2.0
# The Apptainer image of cuju, made from the container image that the Dockerfile builds, for
# Apptainer 1.2 or later, as
#
#     docker build -t cuju:0.1.0 .
#     apptainer build cuju.sif apptainer.def
#
# An image elsewhere, such as a site's registry, comes in with the build arguments
# `--build-arg BOOTSTRAP=docker --build-arg IMAGE=<registry>/<name>:<tag>`.
Bootstrap: {{ BOOTSTRAP }}
From: {{ IMAGE }}

%arguments
    BOOTSTRAP=docker-daemon
    IMAGE=cuju:0.1.0

%labels
    org.opencontainers.image.title cuju
    org.opencontainers.image.source https://github.com/AndreKoraleski/cuju
    org.opencontainers.image.licenses Apache-2.0 AND LGPL-2.1-or-later AND MIT AND SunPro AND BSL-1.0 AND BSD-3-Clause

%help
    cuju plays batched Google Research Football, bit for bit, on CUDA and the CPU.
    It runs Python with the GPU, and `--nv` brings in the host's NVIDIA driver.
        apptainer run --nv cuju.sif my_training.py
    The self-check needs no network.
        apptainer test --nv cuju.sif
    The source of this release, which the LGPL asks for, is in /usr/share/cuju.

%environment
    export PATH=/venv/bin:$PATH

%runscript
    exec python3 "$@"

%test
    # Without `--nv`, as during the build, the CUDA cases are skipped.
    exec /venv/bin/python3 -m pytest -q -p no:cacheprovider /usr/share/cuju/tests
